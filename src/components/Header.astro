---
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const links = [
  { label: "Home", href: "/" },
  { label: "Nav Link 2", href: "/shop" },
  { label: "Nav Link 3", href: "/streamers" },
  { label: "Nav Link 4", href: "/careers" },
  { label: "Nav Link 5", href: "/rules" },
];
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-10 h-[76px] border-b border-border bg-background/90 backdrop-blur"
>
  <div
    class="mx-auto flex h-full max-w-[1360px] items-center justify-between px-6"
  >
    <div class="flex items-center gap-10">
      <a href="/" aria-label="Venoxity home">
        <svg
          width="168"
          height="30"
          viewBox="0 0 168 30"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label="Venoxity"
        >
          <text
            x="0"
            y="23"
            class="font-display"
            font-weight="700"
            font-size="25"
            fill="#ededed"
            textLength="166"
            lengthAdjust="spacing">VENOXITY</text
          >
        </svg>
      </a>
      <nav
        class="hidden items-center gap-8 font-display text-[14px] font-bold uppercase md:flex"
      >
        {
          links.map((l) => (
            <a
              href={l.href}
              class:list={[
                "nav-link transition-colors hover:text-white",
                isActive(l.href) ? "active text-white" : "text-[#aeb3c0]",
              ]}
              aria-current={isActive(l.href) ? "page" : undefined}
            >
              {l.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="/login"
        class="flex items-center gap-2 rounded-lg border border-border bg-surface px-3.5 py-1.5 font-display text-[13px] font-bold uppercase text-white"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle
            cx="12"
            cy="7"
            r="4"></circle></svg
        >
        Login
      </a>
      <a
        href="/"
        class="flex items-center gap-2 rounded-lg bg-[#8b5cf6] px-3.5 py-1.5 font-display text-[13px] font-bold uppercase text-white"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .078-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .079.009c.12.099.245.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
          ></path></svg
        >
        Join Discord
      </a>
    </div>
  </div>
</header>
