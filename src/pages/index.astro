---
import "@fontsource-variable/inter";
import "../styles/global.css";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Venoxity Development</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script id="discord:component-embed" type="application/json">
      {
        "component": {
          "type": 17,
          "components": [
            {
              "type": 9,
              "components": [
                {
                  "type": 10,
                  "content": "## [Venoxity Development](https://venoxity.dev)\nWe build practical, reliable software solutions, including [SimpleHUD](https://www.lcpdfr.com/downloads/gta5mods/scripts/39944-simplehud), [SimpleCTRL](https://www.lcpdfr.com/downloads/gta5mods/scripts/43666-simplectrl), and [more](https://www.youtube.com/watch?v=oHg5SJYRHA0)!"
                }
              ],
              "accessory": {
                "type": 11,
                "media": {
                  "url": "https://venoxity.dev/assets/Og94apc.webp"
                }
              }
            },
            {
              "type": 1,
              "components": [
                {
                  "type": 2,
                  "style": 5,
                  "url": "https://github.com/Venoxity-Development",
                  "label": "Github",
                  "emoji": {
                    "name": "github",
                    "id": "1119818837542576208"
                  }
                },
                {
                  "type": 2,
                  "style": 5,
                  "url": "https://www.lcpdfr.com/profile/531247-venoxity/content/?type=downloads_file",
                  "label": "LSPDFR",
                  "emoji": {
                    "name": "FR",
                    "id": "1206021160639266896"
                  }
                },
                {
                  "type": 2,
                  "style": 5,
                  "url": "https://discord.gg/jCEdAF8AQz",
                  "label": "Discord Server",
                  "emoji": {
                    "name": "discord",
                    "id": "1365007010751578163"
                  }
                }
              ]
            }
          ]
        }
      }
    </script>
  </head>
  <body
    class="min-h-screen flex flex-col justify-between selection:bg-zinc-800 selection:text-white"
  >
    <header class="w-full"></header>

    <main
      class="w-full max-w-xl mx-auto px-6 py-20 flex flex-col items-start text-left animate-fade-in"
    >
      <div class="mb-8 flex items-center gap-4">
        <img
          src="https://venoxity.dev/assets/Og94apc.webp"
          alt="Venoxity Logo"
          class="h-14 w-14 object-contain"
        />
        <div>
          <h1
            class="text-foreground font-semibold text-sm tracking-[0.25em] uppercase"
          >
            Venoxity
          </h1>
          <p
            class="text-muted text-[11px] tracking-[0.25em] uppercase font-medium mt-0.5"
          >
            Development
          </p>
        </div>
      </div>

      <p
        class="text-zinc-200 text-base sm:text-lg leading-relaxed mb-10 font-normal"
      >
        We are currently working hard behind the scenes to craft a new
        generation of immersive experiences and innovative tooling. The new
        platform will be launching soon.
      </p>

      <nav
        class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-medium text-muted"
      >
        <a
          href="https://github.com/Venoxity-Development"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground transition-colors">GitHub</a
        >
        <span class="text-border select-none">/</span>
        <a
          href="https://www.lcpdfr.com/profile/531247-venoxity"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground transition-colors">LSPDFR</a
        >
        <span class="text-border select-none">/</span>
        <a
          href="https://discord.gg/jCEdAF8AQz"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground transition-colors">Discord Server</a
        >
      </nav>
    </main>

    <footer
      class="w-full max-w-xl mx-auto px-6 py-8 text-[11px] text-muted flex justify-between items-center border-t border-[#232733]/60"
    >
      <span>&copy; {year} Venoxity Development</span>
      <span class="text-zinc-600">All rights reserved.</span>
    </footer>
  </body>
</html>
