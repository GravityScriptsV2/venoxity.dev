---
import Layout from "../layouts/Layout.astro";
import SocialNav from "./_components/landing-page/SocialNav.astro";
---

<Layout>
  <main
    class="w-full max-w-xl mx-auto px-6 py-24 flex flex-col items-start text-left animate-fade-in"
  >
    <div class="mb-8 flex items-center gap-4">
      <img
        src="../assets/Og94apc.webp"
        alt="Venoxity Logo"
        class="h-12 w-12 object-contain"
      />
      <div>
        <h1
          class="text-white font-black text-xl tracking-widest uppercase font-display leading-none"
        >
          Venoxity
        </h1>
        <p
          class="text-zinc-500 text-[10px] tracking-[0.25em] uppercase font-bold mt-1"
        >
          Development
        </p>
      </div>
    </div>

    <p
      class="text-zinc-300 text-base sm:text-lg leading-relaxed mb-10 font-normal"
    >
      We are currently working hard behind the scenes to craft a new generation
      of immersive experiences and innovative tooling. The new platform will be
      launching soon.
    </p>

    <SocialNav />
  </main>
</Layout>
