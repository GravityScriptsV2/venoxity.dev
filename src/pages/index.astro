---
import Layout from "../layouts/Layout.astro";
import SocialNav from "./_components/landing-page/SocialNav.astro";
---

<Layout>
  <main
    class="w-full max-w-xl mx-auto px-6 py-24 flex flex-col items-start text-left animate-fade-in"
  >
    <div class="mb-8 flex items-center gap-4">
        <svg
          width="168"
          height="30"
          viewBox="0 0 168 30"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label="Venoxity"
        >
          <text
            x="0"
            y="23"
            class="font-display"
            font-weight="700"
            font-size="25"
            fill="#ededed"
            textLength="166"
            lengthAdjust="spacing">VENOXITY</text
          >
        </svg>
    </div>

    <p
      class="text-zinc-300 text-base sm:text-lg leading-relaxed mb-10 font-normal"
    >
      We are currently working hard behind the scenes to craft a new generation
      of immersive experiences and innovative tooling. The new platform will be
      launching soon.
    </p>

    <SocialNav />
  </main>
</Layout>
