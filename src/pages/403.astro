---
import "@fontsource-variable/inter";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>403 | Venoxity</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body
    class="min-h-screen bg-zinc-950 text-zinc-300 font-sans flex items-center justify-center px-6"
  >
    <main
      class="w-full max-w-xl mx-auto px-6 py-20 flex flex-col items-start text-left animate-fade-in my-auto"
    >
      <div class="space-y-4 mb-10 w-full font-mono text-sm">
        <h1
          class="text-zinc-100 font-semibold text-base sm:text-lg tracking-wide uppercase"
        >
          403 Access Denied
        </h1>

        <p class="text-zinc-400 leading-relaxed font-sans text-base">
          You have been blocked from accessing this site. If you believe this
          was a mistake, please try again later.
        </p>
      </div>
    </main>
  </body>
</html>
