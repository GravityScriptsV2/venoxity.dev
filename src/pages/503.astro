---
import "@fontsource-variable/inter";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>503 | Venoxity</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script id="discord:component-embed" type="application/json">
      {
        "component": {
          "type": 17,
          "components": [
            {
              "type": 10,
              "content": "**We're currently unavailable.**\n\nVenoxity is experiencing a temporary service interruption. We're working to restore access."
            }
          ],
          "accent_color": 15680580
        }
      }
    </script>
  </head>
  <body
    class="min-h-screen bg-zinc-950 text-zinc-300 font-sans flex items-center justify-center px-6"
  >
    <main
      class="w-full max-w-xl mx-auto px-6 py-20 flex flex-col items-start text-left animate-fade-in my-auto"
    >
      <div class="space-y-4 mb-10 w-full font-mono text-sm">
        <h2
          class="text-zinc-100 font-semibold text-base sm:text-lg tracking-wide uppercase"
        >
          503 Service Unavailable
        </h2>
        <p class="text-zinc-400 leading-relaxed font-sans text-base">
          The server was unable to complete your request. Please try again
          later.
        </p>
      </div>
    </main>
  </body>
</html>
